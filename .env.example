# Copy to .env and fill in. Nothing here is a real key.

# --- Core ---
ENVIRONMENT=development
# Postgres. Docker Compose sets this automatically for the `backend` container;
# override here only for local (non-docker) `uvicorn` runs. Host port is 5434,
# not 5432 — see docs/DECISIONS.md #12.
DATABASE_URL=postgresql+psycopg://growthpilot:growthpilot@localhost:5434/growthpilot
SECRET_KEY=change-me-dev-only

# --- LLM (required for Module 1 & 2) ---
ANTHROPIC_API_KEY=
# Model id is configurable on purpose — see docs/DECISIONS.md #4.
CLAUDE_MODEL=claude-sonnet-5

# --- Keyword data (Module 1) ---
# Pay-per-call, no subscription. https://dataforseo.com/apis
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- SERP research (Module 2) ---
SERPAPI_KEY=

# --- Images (Module 2) ---
# Pick ONE. Unsplash is free and used as fallback if the other is unset.
FLUX_API_KEY=
OPENAI_API_KEY_FOR_IMAGES=
UNSPLASH_ACCESS_KEY=

# --- GEO visibility tracker (Module 4) ---
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# ANTHROPIC_API_KEY above is reused as the Claude provider for GEO checks.

# --- Reddit monitor (Module 5) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=growthpilot/0.1 by <your-reddit-username>

# --- Site under management (single-site mode) ---
TARGET_SITE_URL=https://example.com

# --- CORS ---
# Comma-separated. Local dev default is fine as-is; in production add the
# deployed frontend's origin (e.g. https://your-frontend.up.railway.app).
CORS_ALLOWED_ORIGINS=http://localhost:3100
